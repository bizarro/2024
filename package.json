{
  "name": "bizarro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun run --parallel dev:assets dev:worker",
    "dev:assets": "lisergia dev",
    "dev:worker": "wrangler dev --live-reload",
    "build": "bun run build:client",
    "build:client": "lisergia build",
    "check-types": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy --keep-vars",
    "lint": "biome check .",
    "format": "biome format --write .",
    "types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@lisergia/cli": "^26.0.0",
    "@lisergia/config-tsconfig": "^26.0.0",
    "@lisergia/utilities": "^26.0.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.21",
    "auto-bind": "^5.0.1",
    "include-media": "^2.0.0",
    "lenis": "^1.3.26",
    "lodash": "^4.17.21",
    "ogl": "^1.0.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
